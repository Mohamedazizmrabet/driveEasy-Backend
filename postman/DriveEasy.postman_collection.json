{
  "info": {
    "name": "DriveEasy API",
    "description": "Tests de bout en bout de DriveEasy via l'API Gateway (port 8080).\n\nPrérequis : Eureka, Config Server, les 3 microservices et la gateway démarrés.\nLa collection crée son propre client et son propre véhicule (valeurs aléatoires) : elle peut être relancée.\nÀ exécuter dans l'ordre (Run collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8080"
    },
    {
      "key": "eureka",
      "value": "http://localhost:8761"
    },
    {
      "key": "config",
      "value": "http://localhost:8888"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dates relatives au jour d'exécution (location de 3 jours commençant aujourd'hui)",
          "const iso = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(d.getDate()).padStart(2, \"0\")}`;",
          "const plus = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return iso(d); };",
          "pm.collectionVariables.set(\"dateDebut\", plus(0));",
          "pm.collectionVariables.set(\"dateFin\", plus(3));",
          "pm.collectionVariables.set(\"dateChevauchement\", plus(2));",
          "pm.collectionVariables.set(\"dateFinChevauchement\", plus(5));",
          "pm.collectionVariables.set(\"dateRetourRetard\", plus(5));",
          "pm.collectionVariables.set(\"dateDebut2\", plus(10));",
          "pm.collectionVariables.set(\"dateFin2\", plus(12));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Infrastructure",
      "item": [
        {
          "name": "Eureka : 4 services enregistrés",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{eureka}}/eureka/apps"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const noms = pm.response.json().applications.application.map(a => a.name);",
                  "[\"API-GATEWAY\", \"VEHICULE-SERVICE\", \"CLIENT-SERVICE\", \"LOCATION-SERVICE\"].forEach(n =>",
                  "  pm.test(n + \" enregistré\", () => pm.expect(noms).to.include(n)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Config Server : configuration de location-service",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{config}}/location-service/default"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const props = Object.assign({}, ...r.propertySources.map(s => s.source));",
                  "pm.test(\"Port externalisé\", () => pm.expect(props[\"server.port\"]).to.eql(8083));",
                  "pm.test(\"Remise VIP externalisée\", () => pm.expect(props[\"driveeasy.location.remise-vip\"]).to.eql(0.1));",
                  "pm.test(\"Zipkin à 1.0\", () => pm.expect(props[\"management.tracing.sampling.probability\"]).to.eql(1.0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway : health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway : CORS pour Angular (preflight)",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:4200"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": "{{gateway}}/api/vehicules"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Origine autorisée\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:4200\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Véhicules",
      "item": [
        {
          "name": "Lister avec filtres",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/api/vehicules?carburant=DIESEL&prixMax=200"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Filtre carburant et prix\", () => r.forEach(v => {",
                  "  pm.expect(v.carburant).to.eql(\"DIESEL\"); pm.expect(v.prixJournalier).to.be.at.most(200); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer un véhicule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway}}/api/vehicules",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"immatriculation\": \"{{immat}}\",\n  \"marque\": \"Dacia\",\n  \"modele\": \"Sandero\",\n  \"annee\": 2024,\n  \"couleur\": \"Gris\",\n  \"categorie\": \"ECONOMIQUE\",\n  \"carburant\": \"ESSENCE\",\n  \"boite\": \"MANUELLE\",\n  \"nbPlaces\": 5,\n  \"kilometrage\": 1000,\n  \"prixJournalier\": 100,\n  \"imageUrl\": \"https://placehold.co/600x400?text=Dacia+Sandero\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"immat\", `${Math.floor(100 + Math.random() * (999 - 100 + 1))} TU ${Math.floor(1000 + Math.random() * (9999 - 1000 + 1))}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"vehiculeId\", r.id);",
                  "pm.test(\"Statut DISPONIBLE par défaut\", () => pm.expect(r.statut).to.eql(\"DISPONIBLE\"));",
                  "pm.test(\"En-tête Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/vehicules/\" + r.id));"
                ]
              }
