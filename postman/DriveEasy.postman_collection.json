    {
      "name": "2. Clients",
      "item": [
        {
          "name": "Créer un client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway}}/api/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cin\": \"{{cin}}\",\n  \"nom\": \"Postman\",\n  \"prenom\": \"Test\",\n  \"dateNaissance\": \"1995-05-20\",\n  \"email\": \"{{email}}\",\n  \"telephone\": \"+216 20 000 000\",\n  \"adresse\": \"Tunis\",\n  \"numeroPermis\": \"{{permis}}\",\n  \"dateExpirationPermis\": \"2035-01-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Math.floor(10000000 + Math.random() * (99999999 - 10000000 + 1));",
                  "pm.collectionVariables.set(\"cin\", String(n));",
                  "pm.collectionVariables.set(\"email\", `postman.${n}@example.tn`);",
                  "pm.collectionVariables.set(\"permis\", `P-${n}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"clientId\", r.id);",
                  "pm.test(\"Catégorie STANDARD par défaut\", () => pm.expect(r.categorieClient).to.eql(\"STANDARD\"));",
                  "pm.test(\"Permis non expiré\", () => pm.expect(r.permisExpire).to.be.false);"
                ]
              }
            }
          ]
        },
